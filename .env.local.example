# Copy to .env.local for local development. In production, set these in
# Netlify: Site configuration -> Environment variables.

# Required. API key from your Resend account.
RESEND_API_KEY=

# Optional. Sender address for booking enquiry emails.
RESEND_FROM_EMAIL="Hubristic Donkey <bookings@hubristicdonkey.com>"

# Optional. Where booking enquiries get sent. Currently defaults to the dedicated
# hubristicdonkey@gmail.com inbox (watched by the booking-agent tool) until the
# hello@ inbox is set up.
BOOKING_NOTIFY_EMAIL=hubristicdonkey@gmail.com
